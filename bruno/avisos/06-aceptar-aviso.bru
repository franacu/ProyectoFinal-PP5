meta {
  name: Aceptar aviso
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/avisos/{{avisoId}}/aceptacion
  body: json
  auth: none
}

headers {
  X-Usuario: operador1
}

body:json {
  {
    "tipo": "incendio",
    "gravedad": "alta"
  }
}

vars:post-response {
  emergenciaId: res.body.id
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
}
