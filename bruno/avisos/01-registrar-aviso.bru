meta {
  name: Registrar aviso
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/avisos
  body: json
  auth: none
}

headers {
  X-Usuario: ana
}

body:json {
  {
    "ubicacion": {"direccion": "Av. San Martín 450", "localidad": "Ushuaia"},
    "tipo": "incendio",
    "gravedad_estimada": "alta",
    "descripcion": "Humo saliendo de una vivienda"
  }
}

vars:post-response {
  avisoId: res.body.id
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
}
