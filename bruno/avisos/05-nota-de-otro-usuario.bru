meta {
  name: Nota de otro usuario (403)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/avisos/{{avisoId}}/notas
  body: json
  auth: none
}

headers {
  X-Usuario: otro
}

body:json {
  {
    "texto": "No me corresponde"
  }
}

tests {
  test("responde 403", function () {
    expect(res.status).to.equal(403);
  });
}
