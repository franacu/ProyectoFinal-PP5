meta {
  name: PV12 el operador no modifica unidades (403)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/unidades/U-nueva-{{sfx}}/condicion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOperador}}
}

body:json {
  {
    "condicion": "habilitada"
  }
}

tests {
  test("responde 403", function () {
    expect(res.status).to.equal(403);
  });
}
