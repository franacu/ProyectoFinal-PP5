meta {
  name: Persona en dos unidades (409)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/unidades/U-nueva-{{sfx}}/personal
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenRecursos}}
}

body:json {
  {
    "id": "carla",
    "nombre": "Carla Gómez",
    "competencias": [
      "rescate"
    ]
  }
}

tests {
  test("responde 409", function () {
    expect(res.status).to.equal(409);
  });
  test("motivo: RecursoDuplicado", function () {
    expect(res.body.error).to.equal("RecursoDuplicado");
  });
}
