meta {
  name: Iniciar sesión: municipio (reportante)
  type: http
  seq: 2
}

post {
  url: {{keycloakUrl}}/realms/crce/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  client_id: crce-api
  grant_type: password
  username: municipio
  password: crce2026
}

vars:post-response {
  tokenMunicipio: res.body.access_token
}

tests {
  test("Keycloak entrega el token", function () {
    expect(res.status).to.equal(200);
  });
}
