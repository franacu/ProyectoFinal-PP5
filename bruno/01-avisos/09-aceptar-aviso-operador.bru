meta {
  name: Aceptar aviso (operador)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/avisos/{{avisoId}}/aceptacion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOperador}}
}

body:json {
  {
    "tipo": "incendio",
    "gravedad": "alta"
  }
}

vars:post-response {
  emergenciaId: res.body.id
}

tests {
  test("responde 201", function () {
    expect(res.status).to.equal(201);
  });
}
