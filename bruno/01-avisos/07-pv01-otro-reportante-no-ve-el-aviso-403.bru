meta {
  name: PV01 otro reportante no ve el aviso (403)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/avisos/{{avisoId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenMunicipio}}
}

tests {
  test("responde 403", function () {
    expect(res.status).to.equal(403);
  });
  test("motivo: AccesoDenegado", function () {
    expect(res.body.error).to.equal("AccesoDenegado");
  });
}
