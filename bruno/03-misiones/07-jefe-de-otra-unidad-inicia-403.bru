meta {
  name: Jefe de otra unidad inicia (403)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/emergencias/{{emergenciaId}}/misiones/{{misionId}}/inicio
  body: none
  auth: none
}

headers {
  X-Usuario: ana-{{sfx}}
}

tests {
  test("responde 403", function () {
    expect(res.status).to.equal(403);
  });
  test("motivo: NoEsJefeDeLaUnidad", function () {
    expect(res.body.error).to.equal("NoEsJefeDeLaUnidad");
  });
}
