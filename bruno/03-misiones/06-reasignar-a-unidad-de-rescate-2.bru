meta {
  name: Reasignar a unidad de rescate 2
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/emergencias/{{emergenciaId}}/misiones/{{misionId}}/asignacion
  body: json
  auth: none
}

headers {
  X-Usuario: operador1
}

body:json {
  {
    "unidad_id": "U-R2-{{sfx}}"
  }
}

tests {
  test("responde 200", function () {
    expect(res.status).to.equal(200);
  });
}
