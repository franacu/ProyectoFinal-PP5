meta {
  name: Cerrar con mision en curso (409)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/emergencias/{{emergenciaId}}/cierre
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenSupervisor}}
}

tests {
  test("responde 409", function () {
    expect(res.status).to.equal(409);
  });
  test("motivo: MisionSinConcluir", function () {
    expect(res.body.error).to.equal("MisionSinConcluir");
  });
}
