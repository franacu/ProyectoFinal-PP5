meta {
  name: Ambulancia para un rescate (409)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/emergencias/{{emergenciaId}}/misiones/{{misionId}}/asignacion
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOperador}}
}

body:json {
  {
    "unidad_id": "U-ambulancia-1"
  }
}

tests {
  test("responde 409", function () {
    expect(res.status).to.equal(409);
  });
  test("motivo: VehiculoIncompatible", function () {
    expect(res.body.error).to.equal("VehiculoIncompatible");
  });
}
